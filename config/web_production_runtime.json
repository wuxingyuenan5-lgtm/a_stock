{
  "runtime_version": "2.3",
  "project": "A股每日市场监控",
  "repository": "wuxingyuenan5-lgtm/a_stock",
  "branch": "main",
  "timezone": "Asia/Shanghai",
  "entrypoint": {
    "latest_pointer": "data/latest_bundle_pointer.json",
    "latest_validated_workbook": "data/latest_validated_workbook.json",
    "web_run_request": "ops/run_request.json",
    "web_trigger_workflow": ".github/workflows/web_run_trigger.yml",
    "renderer": "run_excel_renderer.py",
    "renderer_version": "1.5",
    "renderer_config": "config/excel_renderer.json"
  },
  "web_daily_protocol": [
    "读取本文件，不再自行搜索或重新理解生产规则",
    "读取 data/latest_bundle_pointer.json；若不存在或日期不是目标交易日，则更新 ops/run_request.json 触发官方 daily_market_monitor workflow",
    "等待 latest pointer 更新到目标交易日，并确认对应 workflow run 已完成",
    "仅下载 pointer 指向的一个 GitHub Actions artifact",
    "读取 data/latest_validated_workbook.json；该文件是滚动母表日期/文件名/SHA的权威来源，bundle/pointer中的expected_mother仅作辅助提示",
    "按 latest_validated_workbook.filename 定位上一份正式验证工作簿；优先当前聊天附件，其次 File Library",
    "若无法取得母表原始 xlsx 二进制，立即停止并要求用户附加该文件；禁止自由重建",
    "直接运行 artifact 内自带 renderer_runtime，一次渲染",
    "读取 renderer_validation；FAIL 不交付，PASS/WARN 才交付",
    "交付成功后更新 data/latest_validated_workbook.json，使今日正式输出成为下一交易日滚动母表"
  ],
  "trigger_policy": {
    "mode": "git_push_bridge_to_workflow_dispatch",
    "request_file": "ops/run_request.json",
    "request_schema": {
      "target_date": "YYYY-MM-DD",
      "requested_by": "web_chat",
      "request_id": "unique string"
    },
    "workflow": ".github/workflows/web_run_trigger.yml",
    "dispatch_target": "daily_market_monitor.yml",
    "never_use_request_file_as_business_data": true
  },
  "mother_policy": {
    "mode": "rolling_previous_validated",
    "registry": "data/latest_validated_workbook.json",
    "registry_is_authoritative": true,
    "bootstrap_only": "A股每日市场监控_优化版_20260810.xlsx",
    "never_rebuild_from_scratch": true,
    "never_use_older_mother_when_validated_registry_has_newer_workbook": true,
    "next_day_mother": "today_successful_output"
  },
  "chart_policy": {
    "update_existing_objects_only": true,
    "forbid_delete_all_drawings": true,
    "forbid_new_charts": true,
    "must_preserve_chart_counts_anchors_and_series_counts": true,
    "series_metric_identity_is_fixed": true,
    "market_chart_titles_must_show_latest_effective_date": true
  },
  "innovation_policy": {
    "amount_share": "innovation amount / same-day all-A amount",
    "turnover": "supplier-direct concept-board turnover only",
    "turnover_primary": "AKShare stock_board_concept_spot_em / stock_board_concept_hist_em",
    "activity_proxy": "retired",
    "fallback_null_never_erases_verified_history": true,
    "historical_non_null_survives_source_switch": true
  },
  "index_policy": {
    "primary": "AKShare index_zh_a_hist standard interface",
    "current_day_fallback": "AKShare stock_zh_index_spot_em bulk index quote",
    "last_fallback": "legacy Eastmoney direct K-line with one delayed retry",
    "avoid_single_endpoint_failure_across_all_three_indices": true
  },
  "data_policy": {
    "renderer_never_calls_market_api": true,
    "all_business_data_from_render_bundle": true,
    "missing_never_zero": true,
    "never_cross_fill_sources": true,
    "same_field_single_stable_interface_preferred": true
  },
  "efficiency_policy": {
    "single_manifest_first": true,
    "single_artifact_download": true,
    "no_repo_wide_search_on_normal_daily_run": true,
    "no_manual_business_recalculation": true,
    "no_full_unit_test_suite_on_normal_production_dispatch": true,
    "slow_shenwan_full_history_refresh_not_in_critical_path": true
  },
  "hard_stop_conditions": [
    "web trigger fails or latest pointer still not target date after official workflow completes",
    "artifact missing required files",
    "mother workbook unavailable as raw xlsx",
    "mother workbook required sheets/chart invariants fail",
    "payload validation FAIL",
    "renderer validation FAIL",
    "chart count/anchor/series-count structure changed",
    "formula error scan fails"
  ],
  "expected_user_command": "生成今天的A股每日市场监控"
}
